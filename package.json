{
  "name": "groky",
  "private": true,
  "version": "0.1.2",
  "description": "An open-source desktop client for Grok Build.",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:frontend": "node --test tests/*.test.ts",
    "test:timing": "node --test tests/timing.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm build && pnpm test:frontend && pnpm test:rust && pnpm check:rust"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.2.8",
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "highlight.js": "^11.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
